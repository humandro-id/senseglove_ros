<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Perfil Fast DDS que deshabilita el transporte por memoria compartida (SHM)
  y fuerza UDPv4. Necesario porque el contenedor corre como root y crea
  segmentos en /dev/shm que el usuario del host no puede abrir, rompiendo
  el discovery entre host y contenedor.

  Uso (host):
    export FASTRTPS_DEFAULT_PROFILES_FILE=/home/fran/senseglove_ros/docker/fastdds_udp_only.xml
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_only</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_only_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
